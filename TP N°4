using System;

class Program
{
    static void Main()
    {
        double baseRect = 10.0, alturaRect = 5.0;
        double area = baseRect * alturaRect;
        Console.WriteLine(area);

        int resto = 100 % 7;
        Console.WriteLine(resto);

        double celsius = 25.0;
        double fahrenheit = celsius * 9.0 / 5.0 + 32;
        Console.WriteLine(fahrenheit);

        string entradaStr = "123";
        int numeroParseado = int.Parse(entradaStr);
        Console.WriteLine(numeroParseado);

        string textoInvalido = "abc";
        if (double.TryParse(textoInvalido, out double resultadoTry))
        {
            Console.WriteLine(resultadoTry);
        }
        else
        {
            Console.WriteLine("Error en la conversion");
        }

        double precioBase = 1000.0;
        double precioConIva = precioBase * 1.21;
        Console.WriteLine(precioConIva);

        int a = 10, b = 3;
        int divisionEntera = a / b;
        double divisionReal = (double)a / b;
        Console.WriteLine(divisionEntera);
        Console.WriteLine(divisionReal);

        int contador = 5;
        contador++;
        Console.WriteLine(contador);

        double valorDecimal = 9.87;
        int valorEntero = (int)valorDecimal;
        Console.WriteLine(valorEntero);

        int totalHoras = 1000;
        int diasCompletos = totalHoras / 24;
        Console.WriteLine(diasCompletos);
    }
}